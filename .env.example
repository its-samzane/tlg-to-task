# ---------------------------------------------------------------------------
# tlg-to-task configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Telegram -----------------------------------------------------------------
# Bot token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id. Send /start to the bot in a private chat to see it.
# Only this user can /register groups (and /delete tasks unless ALLOW_MEMBER_DELETE=true).
OWNER_TELEGRAM_ID=

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string. Migrations run automatically on start.
DATABASE_URL=postgres://tlg:tlg@localhost:5432/tlg_to_task

# --- OpenAI -------------------------------------------------------------------
# Used to transcribe voice messages and to generate task titles.
# Optional: without a key, voice messages are stored without a transcript and
# titles fall back to the first line of text.
OPENAI_API_KEY=
# Chat model used to generate task titles.
OPENAI_MODEL=gpt-4o-mini
# Speech-to-text model used for voice and audio messages.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optional: custom API base URL (proxy or OpenAI-compatible provider).
OPENAI_BASE_URL=

# --- Language & time ----------------------------------------------------------
# Language the bot speaks and records tasks in. One of the files in ./locales (e.g. en, fa).
BOT_LANGUAGE=en
# Optional: language hint for speech-to-text (ISO 639-1). Defaults to BOT_LANGUAGE.
# Set to "auto" to let the model detect the language.
TRANSCRIPTION_LANGUAGE=
# IANA time zone used when formatting dates (e.g. Europe/Berlin, Asia/Tehran).
TZ=UTC

# --- Storage & behaviour ------------------------------------------------------
# Directory where photos, voice messages and files are stored.
STORAGE_DIR=./storage
# Allow any group member to /delete tasks (default: only the owner).
ALLOW_MEMBER_DELETE=false
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
